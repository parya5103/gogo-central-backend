{
  "name": "gogo-central-backend",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "start": "node --import tsx server.ts",
    "test": "tsx tests/firebase-credentials.test.ts && GOGO_TEST_IMPORT=true tsx tests/security-audit.test.ts",
    "test:pg": "GOGO_TEST_IMPORT=true tsx tests/postgres-integration.test.ts",
    "test:matrix": "GOGO_TEST_IMPORT=true tsx tests/notification-matrix.test.ts",
    "db:verify": "tsx scripts/db-manager.ts verify",
    "db:migrate": "tsx scripts/db-manager.ts migrate",
    "db:backup": "tsx scripts/db-manager.ts backup",
    "db:restore": "tsx scripts/db-manager.ts restore",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@vitejs/plugin-react": "^6.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "eslint": "^10.15.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.3",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "pg": "^8.13.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}