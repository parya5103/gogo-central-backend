# ============================================================================
# GoGo Central Backend — Environment Configuration Template (.env.example)
# Never commit real passwords, private keys, or API secrets to Git.
# ============================================================================

NODE_ENV="development"
PORT="3000"

# GEMINI_API_KEY: Injected at runtime by AI Studio Secrets panel if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted Cloud Run service URL or local development URL.
APP_URL="http://localhost:3000"

# Provider-Independent PostgreSQL Mode:
# "local"    -> Local Docker Compose (postgres:18-alpine) or Android Termux native postgresql (₹0)
# "cloudsql" -> Google Cloud SQL for PostgreSQL 18 (Unix socket /cloudsql/... or Private IP)
# "neon"     -> Neon Serverless PostgreSQL Free Tier (TLS SNI pooler)
PG_PROVIDER="local"

# PostgreSQL Connection (Object Method — Local / Cloud SQL / Neon)
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="gogo_central"
SQL_USER="gogo_app_user"
SQL_PASSWORD="CHANGE_ME_IN_SECRET_MANAGER"
SQL_ADMIN_USER="gogo_admin_user"
SQL_ADMIN_PASSWORD="CHANGE_ME_IN_SECRET_MANAGER"

# Strict CORS Allowlist for GoGo Ecosystem Domains
CORS_ALLOWED_ORIGINS="https://gogocompany.in,http://localhost:3000"

# Sandbox Role Header Auth (X-GoGo-Sandbox-Role) — DISABLED BY DEFAULT.
# Set to "true" ONLY for local/CI regression testing in non-production.
# Always rejected when NODE_ENV=production.
GOGO_ENABLE_SANDBOX_AUTH="false"

# Firebase Admin credentials for project gen-lang-client-0566323659.
# Choose ONE supported method:
#   A) GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
#   B) Render Secret File mounted under /etc/secrets
#   C) FIREBASE_SERVICE_ACCOUNT_JSON=<full service-account JSON secret>
#   D) The three explicit secrets below (private key supports escaped \\n).
FIREBASE_PROJECT_ID="gen-lang-client-0566323659"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# FCM Dry Run Mode: when "true", Firebase validates but does not deliver pushes.
# Use "false" or leave unset for real production sends after credentials are set.
FCM_DRY_RUN="true"

# PostgreSQL Runtime (default). The app connects to PostgreSQL at startup,
# applies migrations (schema_migrations-tracked), and serves all state from
# the database. If PostgreSQL is unreachable the service exits with a
# sanitized error — it NEVER silently falls back to in-memory storage.
# Statement/query guard rails (milliseconds) for hostile or stalled queries.
PG_STATEMENT_TIMEOUT_MS="15000"
PG_QUERY_TIMEOUT_MS="15000"

# GOGO_IN_MEMORY_DEMO: explicit demo/test escape hatch. When "true" the app
# runs on the legacy in-memory engine (no persistence, demo seeds). This is
# rejected in production documentation and intended only for offline demos.
# GOGO_TEST_IMPORT is used by test suites for the same purpose.
GOGO_IN_MEMORY_DEMO="false"

# ============================================================================
# DATABASE_URL (optional): standard postgresql:// connection string. The Neon
# CLI writes it into .env.local automatically on `neon deploy`. Explicit SQL_*
# variables above always take precedence; DATABASE_URL only fills in whatever
# the SQL_* set leaves unset (host, port, database, user, password, TLS mode).
# Never commit .env or .env.local (both are gitignored via .env*).
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Neon Realtime variables (NEON_REALTIME_URL / NEON_REALTIME_SECRET) are
# injected by `neon deploy` when realtime is declared in neon.ts. The backend
# does not consume them yet (the FCM worker polls PostgreSQL directly); they
# are documented so the admin panel can adopt live query subscriptions later
# without re-provisioning.
# NEON_REALTIME_URL=""
# NEON_REALTIME_SECRET=""
