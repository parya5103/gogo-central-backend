# ============================================================================
# GoGo Central Backend — Environment Configuration Template (.env.example)
# Never commit real passwords, private keys, or API secrets to Git.
# ============================================================================

NODE_ENV="development"
PORT="3000"

# GEMINI_API_KEY: Injected at runtime by AI Studio Secrets panel if needed.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted service URL or local development URL.
APP_URL="http://localhost:3000"

# Provider-Independent PostgreSQL Mode:
PG_PROVIDER="local"

# PostgreSQL Connection
SQL_HOST="127.0.0.1"
SQL_PORT="5432"
SQL_DB_NAME="gogo_central"
SQL_USER="gogo_app_user"
SQL_PASSWORD="CHANGE_ME_IN_SECRET_MANAGER"
SQL_ADMIN_USER="gogo_admin_user"
SQL_ADMIN_PASSWORD="CHANGE_ME_IN_SECRET_MANAGER"

# Strict CORS Allowlist for GoGo Ecosystem Domains
CORS_ALLOWED_ORIGINS="https://gogocompany.in,http://localhost:3000"

# Sandbox Role Header Auth — disabled by default; never enable in production.
GOGO_ENABLE_SANDBOX_AUTH="false"

# Firebase Admin credentials:
# Preferred on Render: add FIREBASE_SERVICE_ACCOUNT_JSON as a Secret Environment
# Variable containing the COMPLETE service-account JSON downloaded from
# Firebase Console > Project settings > Service accounts. Do not commit it.
# Alternative: add the JSON as a Render Secret File and set
# GOOGLE_APPLICATION_CREDENTIALS to its mounted file path.
# GOOGLE_APPLICATION_CREDENTIALS may also contain the JSON itself for migration.
# The service-account project_id MUST equal gen-lang-client-0566323659.
FIREBASE_SERVICE_ACCOUNT_JSON=""
GOOGLE_APPLICATION_CREDENTIALS=""

# FCM Dry Run Mode: true validates real-token FCM requests without delivery.
FCM_DRY_RUN="true"

# PostgreSQL query guard rails (milliseconds).
PG_STATEMENT_TIMEOUT_MS="15000"
PG_QUERY_TIMEOUT_MS="15000"

# Demo/test escape hatch — never enable in production.
GOGO_IN_MEMORY_DEMO="false"

# DATABASE_URL is optional; explicit SQL_* values take precedence.
# DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Neon Realtime variables are not currently consumed by the backend.
# NEON_REALTIME_URL=""
# NEON_REALTIME_SECRET=""
